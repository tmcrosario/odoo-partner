<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- FORM VIEW -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="category_id" position="replace" />
            <field name="country_id" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
            <field name="vat" position="replace" />
            <field name="website" position="replace" />
            <field name="function" position="replace" />
            <field name="user_id" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
            <!-- 19.0: base.view_partner_form no longer carries the `title` field nor
                 the `sales_purchases`/`internal_notes` pages (they moved out of base),
                 so their previous position="replace" directives were removed. user_id
                 (Salesperson) is hidden directly, and Personal Information is appended
                 to the notebook instead of replacing the old Internal Notes page. -->
            <xpath expr="//notebook" position="inside">
                <page
                    name="personal_information_page"
                    string="Personal Information"
                    invisible="is_company"
                >
                    <group name="personal_information_group">
                        <group>
                            <field name="birthdate" />
                            <field name="dni" />
                        </group>
                        <group>
                            <field name="civil_status" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
